<header class="staynest-header">
  <div class="site-container">
    <!-- Top Telemetry Strip (United Carriers / Illoca style) -->
    <div class="nav-telemetry-strip">
      <div class="nav-telemetry-left">
        <span>STAYNEST® [SYS-VER: 2.6.4]</span>
        <span>•</span>
        <span>LAT 40.7128° N, LNG 74.0060° W</span>
      </div>
      <div class="nav-telemetry-right">
        <span class="status-indicator">
          <span class="status-dot"></span>
          PLATFORM OPERATIONAL // APAC & GLOBAL
        </span>
        <span>•</span>
        <span>EDITION 2026</span>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="staynest-navbar">
      <!-- Brand Logo & Identity -->
      <a href="/listings" class="brand-wrapper">
        <div class="brand-icon-box">
          <i class="fa-solid fa-compass-drafting"></i>
        </div>
        <div class="brand-text-group">
          <span class="brand-title">StayNest</span>
          <span class="brand-tagline">Architectural Sanctuaries</span>
        </div>
      </a>

      <!-- Center Editorial Navigation Links (Desktop & Mobile Drawer) -->
      <ul class="nav-menu-links">
        <li><a href="/listings" class="nav-roll-link">Explore Havens</a></li>
        <li><a href="/expeditions" class="nav-roll-link">Expeditions</a></li>
        <li><a href="/listings?category=Cabins" class="nav-roll-link">Minimalist Cabins</a></li>
        <li><a href="/listings?category=Luxury" class="nav-roll-link">Pavilions & Villas</a></li>
        
        <!-- Mobile Drawer Extras -->
        <li class="mobile-drawer-item">
          <div class="mobile-drawer-divider">
            <span class="mono-stamp" style="font-size: 0.65rem; color: var(--ink-muted); letter-spacing: 0.08em;">ACCOUNT & ACCESS</span>
          </div>
          <% if(!currentUser) { %>
            <div class="mobile-auth-buttons">
              <a href="/login" class="btn-blueprint mobile-sign-in-btn">
                <i class="fa-solid fa-arrow-right-to-bracket" style="margin-right: 0.4rem;"></i> Sign In
              </a>
              <a href="/signup" class="btn-blueprint mobile-register-btn">
                <i class="fa-solid fa-user-plus" style="margin-right: 0.4rem;"></i> Register
              </a>
            </div>
          <% } else { %>
            <div class="mobile-user-profile">
              <div class="nav-user-pill" style="border: none; padding: 0; background: transparent;">
                <div class="nav-user-avatar">
                  <%= currentUser.username ? currentUser.username.charAt(0).toUpperCase() : 'U' %>
                </div>
                <span style="font-weight: 700; margin-left: 0.6rem; color: var(--ink-primary);"><%= currentUser.username %></span>
              </div>
              <a href="/logout" class="btn-blueprint mobile-logout-btn">
                <i class="fa-solid fa-arrow-right-from-bracket" style="margin-right: 0.3rem;"></i> Log Out
              </a>
            </div>
          <% } %>
          <div style="margin-top: 0.75rem;">
            <a href="/listings/new" class="btn-blueprint mobile-list-sanctuary-btn">
              <i class="fa-solid fa-plus" style="margin-right: 0.4rem;"></i> List a Sanctuary
            </a>
          </div>
        </li>
      </ul>

      <!-- Right Actions -->
      <div class="nav-actions">
        <% if(!currentUser) { %>
          <a href="/login" class="nav-roll-link desktop-only-auth" style="margin-right: 0.5rem;">Sign In</a>
          <a href="/signup" class="nav-roll-link desktop-only-auth" style="margin-right: 0.85rem;">Register</a>
        <% } else { %>
          <div class="nav-user-pill desktop-only-user">
            <div class="nav-user-avatar">
              <%= currentUser.username ? currentUser.username.charAt(0).toUpperCase() : 'U' %>
            </div>
            <span class="user-pill-name">
              <%= currentUser.username %>
            </span>
            <a href="/logout" title="Log Out" style="color: var(--ink-muted); margin-left: 0.25rem;">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
          </div>
        <% } %>

        <!-- Kinetic Button for Listing Creation (Icon on mobile, full on desktop) -->
        <a href="/listings/new" class="btn-kinetic nav-create-btn" title="List a Sanctuary">
          <div class="btn-kinetic-icon">
            <i class="fa-solid fa-plus"></i>
          </div>
          <div class="btn-kinetic-label-wrap">
            <div class="btn-kinetic-roll">
              <span>List a Sanctuary</span>
              <span>List a Sanctuary</span>
            </div>
          </div>
        </a>

        <!-- Mobile Menu Toggle -->
        <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Navigation">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </nav>
  </div>
</header>