<% layout("/layouts/boilerplate") %>

<div class="auth-split-wrapper">
  <!-- Left Editorial Branding Pane -->
  <div class="auth-brand-pane">
    <div>
      <div class="badge-architectural badge-cobalt" style="margin-bottom: 1.5rem;">SECURE ACCESS PROTOCOL</div>
      <div class="brand-title" style="color: #fff; font-size: 2rem; margin-bottom: 0.5rem;">StayNest</div>
      <div class="mono-stamp" style="color: #94A3B8;">ARCHITECTURAL HAVENS & SANCTUARIES</div>
    </div>

    <div style="margin: 3rem 0;">
      <blockquote style="font-family: var(--font-display); font-size: 1.35rem; line-height: 1.4; color: #E2E8F0; margin: 0; font-style: italic;">
        "Architecture is the learned game, correct and magnificent, of forms assembled in the light."
      </blockquote>
      <div class="mono-stamp" style="color: var(--brand-coral); margin-top: 0.75rem;">— LE CORBUSIER</div>
    </div>

    <div class="mono-stamp" style="color: #64748B; font-size: 0.7rem;">
      TLS 1.3 ENCRYPTION • LAT 40.7128° N, LNG 74.0060° W
    </div>
  </div>

  <!-- Right Form Pane -->
  <div class="auth-form-pane">
    <div style="margin-bottom: 2rem;">
      <h2 style="font-family: var(--font-display); font-size: 2rem; margin-bottom: 0.35rem;">Sign In</h2>
      <p style="color: var(--ink-secondary); font-size: 0.95rem;">
        Access your curated reservations, saved blueprints, and sanctuary listings.
      </p>
    </div>

    <form action="/login" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input name="username" id="username" type="text" class="form-control" placeholder="Enter your username" required autocomplete="username">
        <div class="invalid-feedback">Please enter your username.</div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input name="password" id="password" type="password" class="form-control" placeholder="••••••••••••" required autocomplete="current-password">
        <div class="invalid-feedback">Please enter your password.</div>
      </div>

      <button type="submit" class="btn-kinetic" style="width: 100%;">
        <div class="btn-kinetic-icon">
          <i class="fa-solid fa-arrow-right"></i>
        </div>
        <div class="btn-kinetic-label-wrap" style="width: 100%; justify-content: center;">
          <div class="btn-kinetic-roll" style="width: 100%; text-align: center;">
            <span>Authorize & Enter</span>
            <span>Authorize & Enter</span>
          </div>
        </div>
      </button>

      <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--ink-muted);">
        Don't have an archive account yet? 
        <a href="/signup" style="color: var(--brand-cobalt); font-weight: 600;">Register here</a>
      </div>
    </form>
  </div>
</div>
